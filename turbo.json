{
   "$schema": "https://turborepo.dev/schema.json",
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "inputs": ["$TURBO_DEFAULT$", ".env*"],
         "outputs": [".next/**", "!.next/cache/**"]
      },
      "dev": {
         "cache": false,
         "persistent": true
      },
      "lint": {
         "dependsOn": ["^lint"]
      },
      "typecheck": {
         "dependsOn": ["^typecheck"]
      }
   }
}
