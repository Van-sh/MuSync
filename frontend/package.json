{
   "name": "frontend",
   "private": true,
   "type": "module",
   "scripts": {
      "build": "bun x --bun vite build",
      "check:all": "bun --parallel --no-exit-on-error format:check lint:check types:check",
      "cn": "shadcn",
      "dev": "NODE_ENV=development bun x --bun vite dev",
      "format": "oxfmt",
      "format:check": "oxfmt --check",
      "lint:check": "oxlint",
      "lint:fix": "oxlint --fix && bun run format",
      "start": "bun run .output/server/index.mjs",
      "types:check": "bun check"
   },
   "dependencies": {
      "@base-ui/react": "^1.9.0",
      "@t3-oss/env-core": "^0.13.10",
